{
  "name": "nocolorcsv",
  "displayName": "NoColorCSV",
  "description": "%extension.description%",
  "version": "0.2.0",
  "publisher": "EETKILLER",
  "repository": {
    "type": "git",
    "url": "https://github.com/EETKILLER/NoColorCSV.git"
  },
  "keywords": [
    "csv",
    "accessibility",
    "navigation"
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:nocolorcsv.showCurrentColumn",
    "onCommand:nocolorcsv.nextColumn",
    "onCommand:nocolorcsv.previousColumn",
    "onCommand:nocolorcsv.nextRow",
    "onCommand:nocolorcsv.previousRow"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "nocolorcsv.showCurrentColumn",
        "category": "NoColorCSV",
        "title": "%command.showCurrentColumn%"
      },
      {
        "command": "nocolorcsv.nextColumn",
        "category": "NoColorCSV",
        "title": "%command.nextColumn%"
      },
      {
        "command": "nocolorcsv.previousColumn",
        "category": "NoColorCSV",
        "title": "%command.previousColumn%"
      },
      {
        "command": "nocolorcsv.nextRow",
        "category": "NoColorCSV",
        "title": "%command.nextRow%"
      },
      {
        "command": "nocolorcsv.previousRow",
        "category": "NoColorCSV",
        "title": "%command.previousRow%"
      }
    ],
    "keybindings": [
      {
        "command": "nocolorcsv.nextColumn",
        "key": "ctrl+alt+shift+right",
        "mac": "cmd+alt+shift+right",
        "when": "editorTextFocus && resourceExtname =~ /^[.]csv$/i"
      },
      {
        "command": "nocolorcsv.previousColumn",
        "key": "ctrl+alt+shift+left",
        "mac": "cmd+alt+shift+left",
        "when": "editorTextFocus && resourceExtname =~ /^[.]csv$/i"
      },
      {
        "command": "nocolorcsv.nextRow",
        "key": "ctrl+alt+shift+down",
        "mac": "cmd+alt+shift+down",
        "when": "editorTextFocus && resourceExtname =~ /^[.]csv$/i"
      },
      {
        "command": "nocolorcsv.previousRow",
        "key": "ctrl+alt+shift+up",
        "mac": "cmd+alt+shift+up",
        "when": "editorTextFocus && resourceExtname =~ /^[.]csv$/i"
      }
    ],
    "configuration": {
      "title": "NoColorCSV",
      "properties": {
        "nocolorcsv.hasHeader": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.hasHeader%"
        },
        "nocolorcsv.columnFocus": {
          "type": "string",
          "enum": [
            "off",
            "cell",
            "column"
          ],
          "default": "column",
          "description": "%configuration.columnFocus%"
        },
        "nocolorcsv.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.statusBar%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/test/column.test.js out/test/extension.test.js",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
